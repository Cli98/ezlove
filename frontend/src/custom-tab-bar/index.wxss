.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: #fbf7f2;
  border-top: 1rpx solid #eee4da;
}

.tab-bar__content {
  display: flex;
  height: calc(50px + env(safe-area-inset-bottom));
}

.tab-bar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  transform: translateY(-6px);
}

.tab-bar__icon {
  width: 24px;
  height: 24px;
}

.tab-bar__text {
  margin-top: 2px;
  font-size: 10px;
  line-height: 14px;
}
