# Database - REQUIRED for backend operation
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/ezlove
REDIS_URL=redis://localhost:6380/0

# JWT signing secret - REQUIRED, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Set to true only in development
DEBUG=false

# WeChat mini-program credentials (optional, for family features)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Anthropic API key (optional, enables AI canteen parsing)
ANTHROPIC_API_KEY=

# LLM configuration (optional, enables AI text suggestions and photo analysis)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus

# AI media generation (not yet available, reserved for future integration)
VIDEO_GEN_API_KEY=
PHOTO_RESTORE_API_KEY=

# Scheduler & notification switches（上线 dry-run 时序控制，默认值=行为与现状一致）
# false 时不启动 APScheduler 定时任务（HTTP 服务照常），用于部署后、正式调度启用前的窗口期
SCHEDULER_ENABLED=true
# false 时告警只落表不发微信通知（notify_family_unread / notify_worker_alert 入口静默），dry-run 静默开关
ALERT_NOTIFY_ENABLED=true
# >0 时家属侧未读告警仅对 created_at >= now-N小时 的未读牵挂生效（R3 冷启动上限；
# COLD_START 阶梯 48→96→168→0 逐档放开，见 P3 §4.2），0 = 不启用
ALERT_COLD_START_UNREAD_HOURS=0
# >0 时工作台 timed_out 查询仅回看 now-N小时 内产生的告警（R9 冷启动限制），0 = 不限
WORKSTATION_TIMED_OUT_LOOKBACK_HOURS=0
